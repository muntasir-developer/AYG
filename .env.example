# InsForge backend — copy to .env.local and fill in real values.
# Public client (user-scoped, safe to expose in the browser).
# Get values:  URL = oss_host in .insforge/project.json
#              ANON key = npx @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Server-only admin key (full access). Never prefix with NEXT_PUBLIC_.
INSFORGE_URL=
INSFORGE_API_KEY=
